# 上傳檔案失敗時追 log（已改 collectorApi 會印出 collector 回傳的 status 與 body）
# 重建 image 後再上傳一次，然後執行：
# docker logs anythingllm 2>&1 | grep -A2 "collector /process failed"

# 除錯 A：前景跑只看 server（不加 -d），錯誤直接印在終端
docker run --rm \
  --network host \
  --env-file /home/jeff/anything-llm/docker/.env \
  -v "/home/jeff/ntu_ai_portal-re":/app/server/storage \
  -e STORAGE_DIR=/app/server/storage \
  --entrypoint /bin/bash \
  anythingllm-local:latest \
  -c "cd /app/server && npx prisma generate --schema=./prisma/schema.prisma && npx prisma migrate deploy --schema=./prisma/schema.prisma && node index.js"

# 除錯 B：追蹤 log（collector 背景、server 前景，server 崩潰時錯誤會出現在 docker logs）
docker stop anythingllm 2>/dev/null; docker rm anythingllm 2>/dev/null
docker run -d \
  --name anythingllm \
  --network host \
  --restart unless-stopped \
  --env-file /home/jeff/anything-llm/docker/.env \
  -v "/home/jeff/ntu_ai_portal-re":/app/server/storage \
  -e STORAGE_DIR=/app/server/storage \
  --cap-add SYS_ADMIN \
  --entrypoint /bin/bash \
  anythingllm-local:latest \
  -c "(node /app/collector/index.js 2>&1) & cd /app/server && export CHECKPOINT_DISABLE=1 && npx prisma generate --schema=./prisma/schema.prisma && npx prisma migrate deploy --schema=./prisma/schema.prisma && node index.js 2>&1"
# 等幾秒後看 log（server 為前景 process，崩潰訊息會在這裡）：
docker logs anythingllm 2>&1

